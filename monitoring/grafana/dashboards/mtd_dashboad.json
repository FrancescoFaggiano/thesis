{
  "id": null,
  "uid": "mtd-dashboard",
  "title": "MTD System Dashboard",
  "tags": ["mtd", "moving-target-defense"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Active Service Containers",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "mtd_controller_active_containers", "legendFormat": "Active Containers" }
      ]
    },
    {
      "type": "graph",
      "title": "Port Mutation Events",
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(mtd_controller_mutations_total[1m]))",
          "legendFormat": "Mutations / min"
        }
      ]
    },
    {
      "type": "table",
      "title": "Current Service Ports",
      "gridPos": { "x": 0, "y": 4, "w": 10, "h": 8 },
      "transformations": [
        { "id": "labelsToFields", "options": {} }
      ],
      "targets": [
        {
          "expr": "mtd_controller_service_port",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Scan Detection Rate",
      "gridPos": { "x": 10, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(mtd_detector_scans_detected_total[1m])",
          "legendFormat": "Scans Detected / min"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Closed Ports (Detector)",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [
        { "expr": "mtd_detector_closed_ports_total", "legendFormat": "Closed Ports" }
      ]
    },
    {
      "type": "heatmap",
      "title": "Suspicious Packet Density",
      "gridPos": { "x": 6, "y": 12, "w": 16, "h": 10 },
      "targets": [
        {
          "expr": "rate(mtd_detector_suspicious_packets_total[5m])",
          "legendFormat": "Suspicious"
        }
      ],
      "heatmap": {}
    }
  ]
}
